<?xml version="1.0" encoding="utf-8"?>
<!--
  AppTheme 0x7f020000 / PetTheme 0x7f020001
  两者 parent 均为 framework 0x0103012c = Theme.DeviceDefault.Light.NoActionBar
  样式条目为 arsc 里 0x0101xxxx 的 framework attr，已按名字还原：
    0x01010056 windowNoTitle   = 0xffffffff → true
    0x0101020d windowFullscreen= 0xffffffff → true
    0x010102cd windowActionBar = 0x00000000 → false
-->
<resources>

    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

    <style name="PetTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

</resources>
